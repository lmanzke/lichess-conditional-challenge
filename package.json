{
  "name": "team-challenge",
  "version": "2.1.0",
  "description": "A vue.js web extension that allows choosing by team",
  "author": "Lucas Manzke",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "build-zip": "npm run build && node scripts/build-zip.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "lint-fix": "eslint --fix src tests",
    "prettier": "prettier --check \"{src,tests}/**/*.{ts,vue,css}\"",
    "prettier:write": "prettier --write \"{src,tests}/**/*.{ts,vue,css}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "^4.0.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
