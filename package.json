{
  "name": "team-challenge",
  "version": "2.3.0",
  "description": "A vue.js web extension that allows choosing based on certain conditions",
  "author": "Lucas Manzke",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun scripts/build.mjs",
    "build:dev": "bun scripts/build.mjs --dev",
    "watch": "bun scripts/build.mjs --dev --watch",
    "build-zip": "bun run build && bun scripts/build-zip.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests",
    "lint-fix": "eslint --fix src tests",
    "format:check": "bun fmt --check src tests",
    "format": "bun fmt src tests",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "^4.1.5",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@effect/platform-bun": "^4.1.5",
    "@eslint/js": "^10.0.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "archiver": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "license": "MIT"
}
