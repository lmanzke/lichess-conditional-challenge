{
  "name": "Lichess Tweaked Challenge Accept",
  "description": "A vue.js web extension that allows choosing by challenges based on certain conditions",
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "icons": {
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://lichess.org/*", "*://*.lichess.org/*"],
      "js": ["challenge/challenge.js"],
      "css": ["challenge/challenge.css"]
    }
  ],
  "permissions": ["storage"],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
